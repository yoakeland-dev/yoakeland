{
  "name": "yoake-gui",
  "version": "0.1.5",
  "description": "yoakeland desktop client",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "electron:dev": "vite dev & YOAKE_DEV_URL=http://127.0.0.1:1420 electron .; kill $!",
    "electron:build": "vite build && electron-builder"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tabler/icons": "^3.46.0",
    "@types/katex": "^0.16.8",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bits-ui": "^2.19.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.15",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "iconoir": "^7.12.1",
    "katex": "^0.16.47",
    "marked": "^18.0.13",
    "material-icon-theme": "^5.38.1",
    "mermaid": "^12.0.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "uqr": "^0.1.3",
    "vite": "^8.0.16"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.aveline.yoake-gui",
    "productName": "yoakeland",
    "files": [
      "build/**",
      "electron/**"
    ],
    "asarUnpack": [
      "build/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "onlyLoadAppFromAsar": true
    },
    "icon": "electron/icon.png",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "jsqr": "^1.4.0"
  }
}
